/* Generated by main/CMakeLists.txt: embed the two immutable reader packs.
 * A 16-byte base alignment plus 4-byte payload alignment in nine_pack.py keeps
 * every RGB565 asset safe for 16-bit loads on the RISC-V target. */
.section .rodata.nine_assets,"a",@progbits
.balign 16
.global nine_script_start
nine_script_start:
.incbin "@NINE_SCRIPT_BIN@"
.global nine_script_end
nine_script_end:
.balign 16
.global nine_images_start
nine_images_start:
.incbin "@NINE_IMAGES_BIN@"
.global nine_images_end
nine_images_end:
.balign 16
